            <Field name="OrderType" type="StringValue" />
            <Field name="RecivedQty" type="DecimalValue" />
            <Field name="ShipmentNumber" type="StringValue" />
        </Fields>
    </Detail>
    <TopLevelEntity name="TransferOrder" screen="IN304000">
                <Fields>
                    <Field name="Branch" type="StringValue" />
                </Fields>
                <Mappings>
                    <Mapping field="Branch">
                        <To object="CurrentDocument" field="BranchID" />
                    </Mapping>
                    <Mapping field="Details">
                        <Mapping field="RecivedQty">
                            <To object="transactions" field="ReceiptedQty" />
                        </Mapping>
                        <Mapping field="ShipmentNumber">
                            <To object="transactions" field="SOShipmentNbr" />
                        </Mapping>
                        <Mapping field="OrderType">
                            <To object="transactions" field="SOOrderType" />
                        </Mapping>
                        <Mapping field="OrderNumber">
                            <To object="transactions" field="SOOrderNbr" />
                        </Mapping>
                        <Mapping field="OrderLineNbr">
                            <To object="transactions" field="SOOrderLineNbr" />
                        </Mapping>
                    </Mapping>
                </Mappings>
            </TopLevelEntity>
    <Detail name="PurchaseReceiptDetail">
                <Fields>
                    <Field name="Project" type="StringValue" />
                </Fields>
            </Detail>
    <TopLevelEntity name="PurchaseReceipt" screen="PO302000">
		<Mappings>
            <Mapping field="Details">
				<Mapping field="Project">
					<To object="transactions" field="ProjectID" />
				</Mapping>
            </Mapping>
        </Mappings>
    </TopLevelEntity>
